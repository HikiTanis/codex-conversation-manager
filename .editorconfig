root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,xaml,ps1,cmd,sln}]
end_of_line = crlf

[*.cs]
indent_style = tab
indent_size = 4

[*.{csproj,xaml,json,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
end_of_line = lf
trim_trailing_whitespace = false
